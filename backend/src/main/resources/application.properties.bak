# Server Configuration
server.port=${SERVER_PORT:8081}

# Application Name
spring.application.name=PlacePro

# Supabase PostgreSQL / Local PostgreSQL Configuration
spring.datasource.url=${SUPABASE_DB_URL}
spring.datasource.username=${SUPABASE_DB_USERNAME}
spring.datasource.password=${SUPABASE_DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA/Hibernate Configuration
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Flyway Migration
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true

# JWT Configuration
# No default is provided on purpose: the application fails fast at startup
# when JWT_SECRET is missing. Generate one with: openssl rand -base64 32
jwt.secret=${JWT_SECRET:}
jwt.expiration=${JWT_EXPIRATION_MS:86400000}

# Google OAuth Configuration
# Used by BOTH flows (must be the SAME Web Client ID everywhere):
#  - OAuth2 authorization-code login (needs ID + SECRET)
#  - Legacy /api/auth/google ID-token verification (needs ID only)
google.client.id=${GOOGLE_CLIENT_ID:}

# Spring Security OAuth2 client (Google authorization-code flow).
# Register this redirect URI in Google Cloud Console > Credentials > OAuth client:
#   http://localhost:8081/login/oauth2/code/google
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID:}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET:}
spring.security.oauth2.client.registration.google.scope=openid,profile,email

# Where the backend sends the user after Google login (React OAuth callback page).
app.frontend.url=${APP_FRONTEND_URL:http://localhost:5173}

# CORS Configuration
# Comma-separated list; override with APP_CORS_ALLOWED_ORIGINS env var in production.
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:3000}

# File Upload Configuration
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB
app.upload.dir=${APP_UPLOAD_DIR:uploads/admin-resources}

# LLM Extraction Configuration
llm.provider=${LLM_PROVIDER:auto}
llm.api-key=${LLM_API_KEY:}
anthropic.api-key=${ANTHROPIC_API_KEY:}
gemini.api-key=${GEMINI_API_KEY:}
# Piston Code Execution API URL (override with PISTON_API_URL env var or spring.property)
piston.api.url=${PISTON_API_URL:https://emkc.org/api/v2}

