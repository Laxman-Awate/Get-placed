# Copy to .env (same directory as docker-compose.yml) and fill in real values.
# Never commit .env — it is ignored by .gitignore.

# Database (used as SUPABASE_DB_* by the backend)
SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/placepro
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=change-me

# Auth — REQUIRED. Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Google OAuth (must match the Web Client ID in frontend/.env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend / CORS
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
SERVER_PORT=8081
