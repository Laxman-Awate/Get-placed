# ==========================================
# DATABASE - SUPABASE
# ==========================================

# Use Supabase Session Pooler for Docker/IPv4 compatibility
SUPABASE_DB_URL=jdbc:postgresql://your-project-region.pooler.supabase.com:5432/postgres
SUPABASE_DB_USERNAME=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-supabase-database-password


# ==========================================
# JWT
# ==========================================

JWT_SECRET=your-jwt-secret
JWT_EXPIRATION_MS=86400000


# ==========================================
# GOOGLE OAUTH
# ==========================================

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ==========================================
# FRONTEND
# ==========================================

APP_FRONTEND_URL=http://localhost:5173

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173


# ==========================================
# VITE FRONTEND VARIABLES
# ==========================================

VITE_GOOGLE_CLIENT_ID=your-google-client-id

VITE_API_BASE_URL=http://localhost:8081/api


# ==========================================
# LLM
# ==========================================

LLM_PROVIDER=auto

LLM_API_KEY=

ANTHROPIC_API_KEY=

GEMINI_API_KEY=


# ==========================================
# PISTON CODE EXECUTION API
# ==========================================

PISTON_API_URL=https://emkc.org/api/v2